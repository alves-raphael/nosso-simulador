---
import Layout from '../layouts/Layout.astro';
import SimuladoresNav from '../components/SimuladoresNav.astro';
---

<Layout
  title="Simulador SAC — Amortização Antecipada"
  description="Simule financiamentos pela tabela SAC e veja quanto você economiza em juros ao antecipar parcelas."
>
  <Fragment slot="header">
    <header class="mb-4">
      <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
        <div>
          <h1 class="h3 fw-bold text-primary">Simulador SAC — Amortização Antecipada</h1>
          <p class="text-muted mb-0">Veja quanto você economiza em juros ao antecipar parcelas</p>
        </div>
        <SimuladoresNav atual="/sac" />
      </div>
    </header>
  </Fragment>

  <div class="card shadow-sm mb-4">
    <div class="card-body p-4">
      <form id="form-sac" novalidate>
        <div class="row g-3">

          <div class="col-md-6">
            <label for="valorImovel" class="form-label fw-semibold">Valor do imóvel (R$)</label>
            <input
              type="text"
              inputmode="decimal"
              id="valorImovel"
              class="form-control"
              placeholder="Ex: 600.000"
            />
            <div class="invalid-feedback" id="erro-valorImovel"></div>
          </div>

          <div class="col-md-6">
            <label for="entrada" class="form-label fw-semibold">Entrada (R$)</label>
            <input
              type="text"
              inputmode="decimal"
              id="entrada"
              class="form-control"
              placeholder="Ex: 100.000"
            />
            <div class="invalid-feedback" id="erro-entrada"></div>
          </div>

          <div class="col-md-6">
            <label for="taxaJuros" class="form-label fw-semibold">Taxa de juros anual (%)</label>
            <input
              type="text"
              inputmode="decimal"
              id="taxaJuros"
              class="form-control"
              placeholder="Ex: 10"
            />
            <div class="invalid-feedback" id="erro-taxaJuros"></div>
          </div>

          <div class="col-md-6">
            <label for="prazo" class="form-label fw-semibold">Prazo (meses)</label>
            <input
              type="number"
              id="prazo"
              class="form-control"
              min="1"
              step="1"
              placeholder="Ex: 360"
            />
            <div class="invalid-feedback" id="erro-prazo"></div>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">
              Efeito da amortização antecipada
              <span
                class="tooltip-icone"
                data-bs-toggle="tooltip"
                data-bs-placement="right"
                data-bs-title="Reduzir prazo: a parcela mensal permanece a mesma e o financiamento quita antes do previsto. Reduzir parcela: o prazo permanece o mesmo, mas as parcelas ficam menores após cada amortização antecipada."
              >?</span>
            </label>
            <div class="d-flex gap-4 mt-1">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="tipoAmortizacao"
                  id="tipo-prazo" value="reduzir-prazo" checked />
                <label class="form-check-label" for="tipo-prazo">Reduzir prazo</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="tipoAmortizacao"
                  id="tipo-parcela" value="reduzir-parcela" />
                <label class="form-check-label" for="tipo-parcela">Reduzir parcela</label>
              </div>
            </div>
          </div>

          <div class="col-12">
            <hr class="my-1" />
            <span class="fw-semibold text-secondary small">
              Amortizações antecipadas
              <span
                class="tooltip-icone"
                data-bs-toggle="tooltip"
                data-bs-placement="right"
                data-bs-title="Informe o mês e o valor de cada pagamento extra além da parcela normal. Cada amortização antecipada abate diretamente o saldo devedor, reduzindo os juros cobrados nos meses seguintes."
              >?</span>
            </span>
          </div>

          <div class="col-12">
            <table class="table table-sm table-bordered mb-2" id="tabela-amort-extras">
              <thead class="table-light">
                <tr>
                  <th>Mês</th>
                  <th>Valor (R$)</th>
                  <th class="text-center" style="width:70px">Remover</th>
                </tr>
              </thead>
              <tbody id="amort-extras-lista">
                <tr id="amort-extras-vazio">
                  <td colspan="3" class="text-center text-muted small py-2">
                    Nenhuma amortização adicionada
                  </td>
                </tr>
              </tbody>
            </table>
            <button type="button" id="btn-add-amort" class="btn btn-sm btn-outline-success">
              + Adicionar amortização
            </button>
          </div>

        </div>

        <div class="mt-4 d-flex gap-2">
          <button type="submit" class="btn btn-primary px-4">Calcular</button>
          <button type="reset" class="btn btn-outline-secondary px-4">Limpar</button>
        </div>
      </form>
    </div>
  </div>

  <div id="resultado-container" class="d-none">

    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="resumo-card h-100">
          <h2 class="h6 fw-bold text-primary mb-3">Sem amortização extra</h2>
          <div class="resumo-item">
            <span class="resumo-label">Total de juros</span>
            <span class="resumo-valor" id="base-total-juros">—</span>
          </div>
          <div class="resumo-item">
            <span class="resumo-label">Total pago</span>
            <span class="resumo-valor" id="base-total-pago">—</span>
          </div>
          <div class="resumo-item">
            <span class="resumo-label">Prazo</span>
            <span class="resumo-valor" id="base-prazo">—</span>
          </div>
          <div class="resumo-item">
            <span class="resumo-label">Total + Entrada</span>
            <span class="resumo-valor" id="base-total-com-entrada">—</span>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="resumo-card resumo-card-destaque h-100">
          <h2 class="h6 fw-bold mb-3" style="color: var(--cor-acento)">Com amortização extra</h2>
          <div class="resumo-item">
            <span class="resumo-label">Total de juros</span>
            <span class="resumo-valor" id="amort-total-juros">—</span>
          </div>
          <div class="resumo-item">
            <span class="resumo-label">Total pago</span>
            <span class="resumo-valor" id="amort-total-pago">—</span>
          </div>
          <div class="resumo-item">
            <span class="resumo-label">Prazo efetivo</span>
            <span class="resumo-valor" id="amort-prazo">—</span>
          </div>
          <div class="resumo-item">
            <span class="resumo-label fw-semibold">Economia em juros</span>
            <span class="resumo-valor fw-bold text-success" id="amort-economia">—</span>
          </div>
          <div class="resumo-item" id="row-meses-antecip">
            <span class="resumo-label fw-semibold">Meses antecipados</span>
            <span class="resumo-valor fw-bold text-success" id="amort-meses-antecip">—</span>
          </div>
          <div class="resumo-item">
            <span class="resumo-label">Total + Entrada</span>
            <span class="resumo-valor" id="amort-total-com-entrada">—</span>
          </div>
        </div>
      </div>
    </div>

    <h2 class="h5 fw-semibold mb-3">Tabela de amortização</h2>
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-striped table-hover mb-0" id="tabela-resultado">
            <thead class="table-primary">
              <tr>
                <th scope="col" class="text-center">Mês</th>
                <th scope="col" class="text-end">Saldo inicial</th>
                <th scope="col" class="text-end">Amortização</th>
                <th scope="col" class="text-end">Amort. extra</th>
                <th scope="col" class="text-end">Juros</th>
                <th scope="col" class="text-end">Parcela</th>
                <th scope="col" class="text-end">Saldo final</th>
              </tr>
            </thead>
            <tbody id="resultado-body"></tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

  <Fragment slot="scripts">
    <script>
      import '../scripts/sac-ui.js';
    </script>
  </Fragment>
</Layout>
