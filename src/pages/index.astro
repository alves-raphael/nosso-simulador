---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Simulador de Consórcio Imobiliário">
  <Fragment slot="header">
    <header class="mb-4">
      <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
        <div>
          <h1 class="h3 fw-bold text-primary">Simulador de Consórcio Imobiliário</h1>
          <p class="text-muted mb-0">Calcule suas parcelas com reajuste anual</p>
        </div>
        <a href="/sac" class="btn btn-sm btn-outline-secondary align-self-center">Simulador SAC →</a>
      </div>
    </header>
  </Fragment>

  <div class="card shadow-sm mb-4">
    <div class="card-body p-4">
      <form id="form-simulador" novalidate>
        <div class="row g-0">

          <!-- Esquerda: dados do consórcio -->
          <div class="col-12 col-md-6 form-col-esquerda pe-md-4">
            <div class="row g-3">
              <div class="col-12">
                <label for="valorImovel" class="form-label fw-semibold">Valor do Imóvel (R$)</label>
                <input
                  type="text"
                  inputmode="decimal"
                  id="valorImovel"
                  class="form-control"
                  placeholder="Ex: 300.000"
                />
                <div class="invalid-feedback" id="erro-valorImovel"></div>
              </div>
              <div class="col-12">
                <label for="taxaAdm" class="form-label fw-semibold">Taxa de Administração (%)</label>
                <input
                  type="text"
                  inputmode="decimal"
                  id="taxaAdm"
                  class="form-control"
                  placeholder="Ex: 18"
                />
                <div class="invalid-feedback" id="erro-taxaAdm"></div>
              </div>
              <div class="col-12">
                <label for="meses" class="form-label fw-semibold">Prazo (meses)</label>
                <input
                  type="number"
                  id="meses"
                  class="form-control"
                  min="1"
                  step="1"
                  placeholder="Ex: 120"
                />
                <div class="invalid-feedback" id="erro-meses"></div>
              </div>
              <div class="col-12">
                <label for="reajuste" class="form-label fw-semibold">
                  Reajuste anual (%)
                  <span
                    class="tooltip-icone"
                    data-bs-toggle="tooltip"
                    data-bs-placement="right"
                    data-bs-title="Na prática, as parcelas do consórcio são corrigidas por índices variáveis como INCC ou IPCA, que oscilam a cada ano. Este campo permite presumir uma média anual para ter uma estimativa do impacto ao longo do tempo — não representa um valor fixo garantido."
                  >?</span>
                </label>
                <input
                  type="text"
                  inputmode="decimal"
                  id="reajuste"
                  class="form-control"
                  value="5"
                />
                <div class="invalid-feedback" id="erro-reajuste"></div>
              </div>
            </div>
          </div>

          <!-- Direita: aluguel -->
          <div class="col-12 col-md-6 form-col-direita ps-md-4">
            <p class="form-secao-titulo">
              Ainda paga aluguel?
              <span
                class="tooltip-icone"
                data-bs-toggle="tooltip"
                data-bs-placement="right"
                data-bs-title="Se você ainda paga aluguel enquanto participa do consórcio, informe o valor atual e a correção anual esperada. O simulador mostrará o total acumulado de aluguel mês a mês, ajudando a visualizar o custo de não ter o imóvel próprio durante esse período."
              >?</span>
            </p>
            <div class="row g-3">
              <div class="col-12">
                <label for="valorAluguel" class="form-label fw-semibold">Valor do aluguel (R$)</label>
                <input
                  type="text"
                  inputmode="decimal"
                  id="valorAluguel"
                  class="form-control"
                  placeholder="Ex: 2.000 (deixe vazio para ignorar)"
                />
                <div class="invalid-feedback" id="erro-valorAluguel"></div>
              </div>
              <div class="col-12">
                <label for="taxaCorrecaoAluguel" class="form-label fw-semibold">Correção anual do aluguel (%)</label>
                <input
                  type="text"
                  inputmode="decimal"
                  id="taxaCorrecaoAluguel"
                  class="form-control"
                  value="5"
                />
                <div class="invalid-feedback" id="erro-taxaCorrecaoAluguel"></div>
              </div>
            </div>
          </div>

        </div>

        <div class="mt-4 d-flex gap-2">
          <button type="submit" class="btn btn-primary px-4">Calcular</button>
          <button type="reset" class="btn btn-outline-secondary px-4">Limpar</button>
        </div>
      </form>
    </div>
  </div>

  <div id="resultado-container" class="d-none">

    <div class="resumo-card mb-4">
      <h2 class="h6 fw-bold text-primary mb-3">Resumo da simulação</h2>
      <div class="resumo-item">
        <span class="resumo-label">Taxa de administração total</span>
        <span class="resumo-valor" id="resumo-taxaAdm">—</span>
      </div>
      <div class="resumo-item">
        <span class="resumo-label">Total a financiar (crédito + taxa)</span>
        <span class="resumo-valor" id="resumo-totalBruto">—</span>
      </div>
      <div class="resumo-item">
        <span class="resumo-label">Parcela base (sem reajuste)</span>
        <span class="resumo-valor" id="resumo-quotaBase">—</span>
      </div>
      <div class="resumo-item">
        <span class="resumo-label">Total pago (com reajustes)</span>
        <span class="resumo-valor" id="resumo-totalPago">—</span>
      </div>
      <div class="resumo-item col-aluguel">
        <span class="resumo-label">Total de aluguel pago</span>
        <span class="resumo-valor" id="resumo-totalAluguel">—</span>
      </div>
    </div>

    <h2 class="h5 fw-semibold mb-3">Tabela de parcelas</h2>
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-striped table-hover mb-0" id="tabela-resultado">
            <thead class="table-primary">
              <tr>
                <th scope="col" class="text-center">Mês</th>
                <th scope="col" class="text-center">Reajuste acumulado</th>
                <th scope="col" class="text-end">Parcela do mês</th>
                <th scope="col" class="text-end">Total pago até aqui</th>
                <th scope="col" class="col-aluguel text-end">Aluguel acumulado</th>
              </tr>
            </thead>
            <tbody id="resultado-body"></tbody>
            <tfoot class="table-dark fw-bold">
              <tr>
                <td colspan="2">Total pago</td>
                <td class="text-end" id="total-pago"></td>
                <td class="text-end"></td>
                <td class="col-aluguel text-end" id="total-aluguel"></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

  </div>

  <Fragment slot="scripts">
    <script>
      import '../scripts/ui.js';
    </script>
  </Fragment>
</Layout>
