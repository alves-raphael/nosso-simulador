---
import Layout from '../layouts/Layout.astro';
import SimuladoresNav from '../components/SimuladoresNav.astro';
---

<Layout
  title="Simulador de Juros Compostos"
  description="Simule o crescimento do seu dinheiro mês a mês com aportes mensais e juros compostos."
>
  <Fragment slot="header">
    <header class="mb-4">
      <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
        <div>
          <h1 class="h3 fw-bold text-primary">Simulador de Juros Compostos</h1>
          <p class="text-muted mb-0">Veja como seu dinheiro cresce mês a mês com aportes e juros</p>
        </div>
        <SimuladoresNav atual="/juros-compostos" />
      </div>
    </header>
  </Fragment>

  <div class="card shadow-sm mb-4">
    <div class="card-body p-4">
      <form id="form-juros-compostos" novalidate>
        <div class="row g-3">

          <div class="col-md-6">
            <label for="valorInicial" class="form-label fw-semibold">Valor inicial (R$)</label>
            <input
              type="text"
              inputmode="decimal"
              id="valorInicial"
              class="form-control"
              placeholder="Ex: 10.000"
            />
            <div class="invalid-feedback" id="erro-valorInicial"></div>
          </div>

          <div class="col-md-6">
            <label for="aporteMensal" class="form-label fw-semibold">Aporte mensal (R$)</label>
            <input
              type="text"
              inputmode="decimal"
              id="aporteMensal"
              class="form-control"
              placeholder="Ex: 500"
            />
            <div class="invalid-feedback" id="erro-aporteMensal"></div>
          </div>

          <div class="col-md-6">
            <label for="taxaJuros" class="form-label fw-semibold">Taxa de juros (%)</label>
            <input
              type="text"
              inputmode="decimal"
              id="taxaJuros"
              class="form-control"
              placeholder="Ex: 10"
            />
            <div class="invalid-feedback" id="erro-taxaJuros"></div>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">Periodicidade da taxa</label>
            <div class="d-flex gap-4 mt-1">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="periodicidadeTaxa"
                  id="periodicidade-ano" value="ano" checked />
                <label class="form-check-label" for="periodicidade-ano">% ao ano</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="periodicidadeTaxa"
                  id="periodicidade-mes" value="mes" />
                <label class="form-check-label" for="periodicidade-mes">% ao mês</label>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <label for="periodo" class="form-label fw-semibold">Período</label>
            <input
              type="number"
              id="periodo"
              class="form-control"
              min="1"
              step="1"
              placeholder="Ex: 10"
            />
            <div class="invalid-feedback" id="erro-periodo"></div>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold">Unidade do período</label>
            <div class="d-flex gap-4 mt-1">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="periodicidadePeriodo"
                  id="periodo-ano" value="ano" checked />
                <label class="form-check-label" for="periodo-ano">Anos</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="periodicidadePeriodo"
                  id="periodo-mes" value="mes" />
                <label class="form-check-label" for="periodo-mes">Meses</label>
              </div>
            </div>
          </div>

        </div>

        <div class="mt-4 d-flex gap-2">
          <button type="submit" class="btn btn-primary px-4">Calcular</button>
          <button type="reset" class="btn btn-outline-secondary px-4">Limpar</button>
        </div>
      </form>
    </div>
  </div>

  <div id="resultado-container" class="d-none">

    <div class="resumo-card mb-4">
      <h2 class="h6 fw-bold text-primary mb-3">Resumo da simulação</h2>
      <div class="resumo-item">
        <span class="resumo-label">Total aportado</span>
        <span class="resumo-valor" id="resumo-totalAportado">—</span>
      </div>
      <div class="resumo-item">
        <span class="resumo-label">Total de juros</span>
        <span class="resumo-valor" id="resumo-totalJuros">—</span>
      </div>
      <div class="resumo-item">
        <span class="resumo-label fw-semibold">Montante final</span>
        <span class="resumo-valor fw-bold text-success" id="resumo-montanteFinal">—</span>
      </div>
    </div>

    <h2 class="h5 fw-semibold mb-3">Tabela de evolução</h2>
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-striped table-hover mb-0" id="tabela-resultado">
            <thead class="table-primary">
              <tr>
                <th scope="col" class="text-center">Mês</th>
                <th scope="col" class="text-end">Saldo inicial</th>
                <th scope="col" class="text-end">Juros</th>
                <th scope="col" class="text-end">Aporte</th>
                <th scope="col" class="text-end">Saldo final</th>
              </tr>
            </thead>
            <tbody id="resultado-body"></tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

  <Fragment slot="scripts">
    <script>
      import '../scripts/juros-compostos-ui.js';
    </script>
  </Fragment>
</Layout>
