---
import "../styles/global.css";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <!-- Google tag (gtag.js) -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-8QBBYP3PE0"
        ></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(...args: unknown[]) {
                dataLayer.push(args);
            }
            gtag("js", new Date());

            gtag("config", "G-8QBBYP3PE0");
        </script>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        />
    </head>
    <body>
        <div class="container py-5">
            <slot name="header" />

            <slot />
        </div>

        <footer class="text-center text-muted small py-4 border-top mt-2">
            Dúvidas ou sugestões? Entre em contato:
            <a href="mailto:alves.raphael100@gmail.com"
                >alves.raphael100@gmail.com</a
            >
        </footer>

        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        ></script>
        <slot name="scripts" />
    </body>
</html>
